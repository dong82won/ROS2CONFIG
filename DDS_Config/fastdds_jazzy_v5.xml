<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <!-- 1. POSIX Shared Memory Transport (단일 PC 초고속 Zero-Copy) -->
            <transport_descriptor>
                <transport_id>shm_transport</transport_id>
                <type>SHM</type>
                <maxMessageSize>10485760</maxMessageSize> <!-- 10MB -->
                <segment_size>67108864</segment_size>   <!-- 64MB (호스트 vm.max_map_count 최적화) -->
                <port_queue_capacity>1024</port_queue_capacity>
                <healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
            </transport_descriptor>

            <!-- 2. UDPv4 Network Transport (외부 기기 통신) -->
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>

                <type>UDPv4</type>
                <!-- 호스트 rmem_max / wmem_max(256MB)에 맞춰 64MB로 대폭 확장 -->
                <sendBufferSize>67108864</sendBufferSize>
                <receiveBufferSize>67108864</receiveBufferSize>
                <maxMessageSize>65500</maxMessageSize>
                <non_blocking_send>true</non_blocking_send>

                <!--
                [네트워크 인터페이스 바인딩 가이드]
                    - 특정 인터페이스만 강제하려면 아래 주석을 해제하고 지정하세요.
                    - 비워둘 경우 OS 기본 라우팅 테이블(Default Gateway)을 따라 유선/무선이 자동 적용됩니다.
                -->
                <interfaceWhiteList>
                    <address>enx00e04c6841ec</address>
                    <address>wlan0</address>
                    <address>lo</address>
                </interfaceWhiteList>

            </transport_descriptor>
        </transport_descriptors>

        <!-- 기본 참가자 프로파일 -->
        <participant profile_name="fastdds_optimized_profile" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>shm_transport</transport_id>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>

                <builtin>
                    <discovery_config>
                        <discoveryProtocol>SIMPLE</discoveryProtocol>
                        <!-- 무선(Wi-Fi) 지연 환경을 고려하여 3초 -> 8초로 완화 (노드 깜빡임 방지) -->
                        <leaseDuration>
                            <sec>8</sec>
                        </leaseDuration>
                        <leaseAnnouncement>
                            <sec>2</sec>
                        </leaseAnnouncement>
                        <initialAnnouncements>
                            <count>5</count>
                            <period>
                                <sec>0</sec>
                                <nanosec>100000000</nanosec>
                            </period>
                        </initialAnnouncements>
                    </discovery_config>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
